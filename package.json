{
  "name": "anonymous-chatting-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --bail",
    "test:watch": "jest --watchAll",
